<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title | default("Full-Length 16S rRNA Bacterial Detection Report") }}</title>

<style>
  *{box-sizing:border-box}
  body{
    margin:0;
    background:#fff;
    color:#1a1a1a;
    font-family:Arial, Helvetica, sans-serif;
    font-size:13px;
    line-height:1.6;
  }
  .page{
    max-width:780px;
    margin:0 auto;
    padding:32px 40px;
  }
  h1{
    font-size:18px;
    font-weight:700;
    margin:0 0 4px;
    text-align:center;
  }
  .lab-name{
    text-align:center;
    font-size:14px;
    font-weight:700;
    margin-bottom:2px;
  }
  .subtitle{
    text-align:center;
    font-size:12px;
    color:#444;
    margin-bottom:20px;
  }
  /* Two-box header: title block (6) beside meta block (3). */
  .report-header{
    display:flex;
    align-items:stretch;
    gap:12px;
    margin-bottom:8px;
  }
  .report-header-title{
    flex:6;
    border:1px solid #888;
    padding:10px 14px;
  }
  .report-header-meta{
    flex:3;
    border:1px solid #888;
    padding:10px 14px;
    display:flex;
    flex-direction:column;
    justify-content:center;
  }
  /* Header boxes are compact — drop the standalone-header vertical spacing. */
  .report-header .lab-name{margin-bottom:2px}
  .report-header h1{margin:0 0 4px}
  .report-header .subtitle{margin-bottom:0}
  .report-header .meta{margin-bottom:2px}
  .meta{
    text-align:right;
    font-size:12px;
    margin-bottom:4px;
  }
  .separator{
    border:none;
    border-top:2px solid #1a1a1a;
    margin:16px 0;
  }
  .section-title{
    font-size:13px;
    font-weight:700;
    text-transform:uppercase;
    margin:20px 0 8px;
  }
  p{
    margin:0 0 10px;
  }
  .field{
    margin-bottom:4px;
  }
  .field-label{
    display:inline-block;
    width:150px;
    color:#444;
  }
  .field-value{
    font-weight:600;
  }
  .result-block{
    border:2px solid #1a1a1a;
    padding:14px 18px;
    margin-bottom:12px;
  }
  .conclusion{
    font-size:18px;
    font-weight:800;
  }
  table{
    width:100%;
    border-collapse:collapse;
    margin-bottom:12px;
    font-size:12px;
  }
  th, td{
    border:1px solid #888;
    padding:6px 10px;
    text-align:left;
    vertical-align:top;
  }
  th{
    font-weight:700;
    background:#f5f5f5;
  }
  .footer{
    padding-top:12px;
    border-top:2px solid #1a1a1a;
    font-size:11px;
    color:#444;
    display:flex;
    justify-content:space-between;
  }

  /* Status colors — reused across conclusion, QC, and species table */
  .status-danger{color:#9b1c1c; font-weight:700}
  .status-ok{color:#137333; font-weight:700}
  .status-warn{color:#c05600; font-weight:700}

  /* Keep tables (and their rows) from being split across page breaks. */
  table{break-inside:avoid; page-break-inside:avoid}
  tr, th, td{break-inside:avoid; page-break-inside:avoid}
  .result-block{break-inside:avoid; page-break-inside:avoid}

  /* Screen: footer sits at the end of the content flow. */
  .footer{margin-top:28px}

  /* Screen: the print-only running footer is hidden (the in-flow .footer
     handles the on-screen HTML view). */
  .auth-footer{display:none;}

  @page{
    size:A4;
    margin:14mm 14mm 22mm;   /* reserve bottom space for the repeating footer */
    @bottom-left{
      /* Replay the whole .auth-footer element (see position:running below),
         so it can carry markup — not just a flattened string. */
      content:element(authFooter);
    }
    @bottom-right{
      content:"Page " counter(page) " of " counter(pages);
      font-family:Arial, Helvetica, sans-serif;
      font-size:10px;
      color:#444;
    }
  }

  @media print{
    .page{max-width:none; padding:0}
    /* Pull the authorization footer out of normal flow and park it under the
       name "authFooter". The @bottom-left margin box above replays it on every
       page via content:element(). This is WeasyPrint's native running-element
       mechanism — no off-screen positioning hack, and it preserves markup. */
    .auth-footer{
      display:block;
      position:running(authFooter);
      font-family:Arial, Helvetica, sans-serif;
      font-size:10px;
      color:#444;
    }
    /* The in-flow footer is replaced by the repeating running element, so hide
       it in print to avoid duplicating the authorization line. */
    .footer{display:none}
  }
</style>

</head>
<body>
<div class="page">

  {# Print-only running footer: pulled out of flow via position:running(authFooter)
     and replayed by the @bottom-left margin box on every page. Hidden on screen
     (the in-flow .footer below handles the HTML view). Because it's a real
     element (not a flattened string), it can carry markup. #}
  <div class="auth-footer">Authorized by: {{ authorized_by or "__________________________" }}</div>

  {# ─── Header ─── #}
  <div class="report-header">
    <div class="report-header-title">
      <p class="lab-name">Molecular Microbiology Laboratory</p>
      <h1>Full-Length 16S rRNA Bacterial Detection</h1>
      <p class="subtitle">Broad-range bacterial detection and identification from clinical specimens</p>
    </div>
    <div class="report-header-meta">
      <p class="meta"><strong>Report ID:</strong> {{ report_id or "N/A" }}</p>
      <p class="meta"><strong>Reported:</strong> {{ report_date }}</p>
      <p class="meta"><strong>Status:</strong> {{ status or "Final" }}</p>
    </div>
  </div>

  <hr class="separator">

  {# ─── Patient Information ─── #}
  <div class="section-title">Patient Information</div>
  <p class="field"><span class="field-label">Patient name</span><span class="field-value">{{ patient_name or "N/A" }}</span></p>
  <p class="field"><span class="field-label">HN</span><span class="field-value">{{ patient_id or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Date of birth</span><span class="field-value">{{ dob or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Age</span><span class="field-value">{{ age or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Gender</span><span class="field-value">{{ gender or "N/A" }}</span></p>

  {# ─── Specimen Information ─── #}
  <div class="section-title">Specimen Information</div>
  <p class="field"><span class="field-label">Specimen ID</span><span class="field-value">{{ specimen_id or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Specimen type</span><span class="field-value">{{ specimen_type or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Collection date</span><span class="field-value">{{ collection_date or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Received date</span><span class="field-value">{{ received_date or "N/A" }}</span></p>

  {# ─── Ordering & Test Information ─── #}
  <div class="section-title">Ordering &amp; Test Information</div>
  <p class="field"><span class="field-label">Ordering physician</span><span class="field-value">{{ ordering_physician or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Healthcare provider</span><span class="field-value">{{ healthcare_provider or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Reason for testing</span><span class="field-value">{{ reason_for_testing or "N/A" }}</span></p>
  <p class="field"><span class="field-label">Test performed</span><span class="field-value">{{ test_performed or "N/A" }}</span></p>

  {# ─── Results ─── #}
  <div class="section-title">Result</div>

  {# Bacterial DNA result box #}
  <div class="result-block">
    <p><strong>Bacterial DNA:</strong>
    {% if conclusion == "pathogen_detected" %}
      <span class="conclusion status-danger">PATHOGEN DETECTED</span>
    {% elif conclusion == "organism_detected" %}
      <span class="conclusion status-warn">ORGANISM DETECTED</span>
    {% elif conclusion == "not_detected" %}
      <span class="conclusion status-ok">NOT DETECTED</span>
    {% endif %}
    </p>
  </div>

  {# Species table #}
  {% if organisms %}
  <table>
    <tr>
      <th>Species</th>
      <th>Abundance (%)</th>
      <th>Sequence identity (%)</th>
      <th>Pathogenic</th>
    </tr>
    {% for org in organisms %}
    <tr>
      <td><em>{{ org.name }}</em></td>
      <td>{{ org.abundance }}</td>
      <td>{{ org.identity if org.identity is not none else "N/A" }}</td>
      {% if org.pathogenic is none or org.pathogenic == "" %}
      <td>N/A</td>
      {% elif org.pathogenic == "primary" %}
      <td class="status-danger">{{ org.pathogenic | capitalize }}</td>
      {% elif org.pathogenic == "opportunistic" %}
      <td class="status-warn">{{ org.pathogenic | capitalize }}</td>
      {% else %}
      <td>{{ org.pathogenic | capitalize }}</td>
      {% endif %}
    </tr>
    {% endfor %}
  </table>
  {% else %}
  <p>No bacterial taxon met the laboratory-established reporting criteria.</p>
  {% endif %}

  {# ─── Quality Control ─── #}
  <div class="section-title">Quality Control</div>
  <table>
    <tr><th>Parameter</th><th>Status</th></tr>
    {% for qc in qc_items %}
    <tr>
      <td>{{ qc.name }}</td>
      <td class="{{ 'status-ok' if qc.status == 'pass' else 'status-warn' }}">{{ qc.status | upper }}</td>
    </tr>
    {% endfor %}
  </table>

  {# ─── Analytical Evidence ─── #}
  <div class="section-title">Analytical Evidence</div>
  <table>
    <tr><th style="width:170px">Target</th><td>Full-length bacterial 16S rRNA gene (V1-V9)</td></tr>
    {% if organisms %}
    <tr><th style="width:170px">Reporting criteria</th><td>Met laboratory-validated detection and background thresholds</td></tr>
    {% else %}
    <tr><th style="width:170px">Result classification</th><td>Not detected</td></tr>
    <tr><th style="width:170px">Reporting criteria</th><td>No bacterial taxon exceeded validated detection and background thresholds</td></tr>
    {% endif %}
    <tr><th style="width:170px">Reference database</th><td>{{ reference_db or "Validated bacterial 16S reference database" }}</td></tr>
  </table>

  {# ─── Method ─── #}
  <div class="section-title">Method</div>
  <p>{{ method or "Broad-range amplification of the bacterial full-length 16S rRNA gene followed by long-read sequencing and validated taxonomic classification." }}</p>

  {# ─── Limitations ─── #}
  <div class="section-title">Limitations</div>
  {% if organisms %}
  <p>This assay detects bacterial DNA and does not determine organism viability or antimicrobial susceptibility.
  Some closely related bacterial species cannot be reliably distinguished by 16S rRNA sequencing alone.
  Results should be interpreted with conventional microbiology and clinical findings.</p>
  {% else %}
  <p>A negative result does not exclude bacterial infection below the analytical limit of detection.
  PCR inhibitors, low bacterial burden, sequence variation at primer-binding sites, or specimen quality may affect assay sensitivity.
  Antimicrobial susceptibility is not assessed by this test.</p>
  {% endif %}

  {# ─── Disclaimer ─── #}
  <div class="section-title">Disclaimer</div>
  <p>The integrated molecular classification result using nanopore sequencing is a tool development for <b>research use only (RUO)</b>. The test results are based on current knowledge and technology. It has not been verified or clinically validated and must not be used for diagnosis purposes.</p>

  {# ─── Footer (on-screen HTML only; print uses the repeating running footer) ─── #}
  <div class="footer">
    <span class="authorized-by">Authorized by: {{ authorized_by or "__________________________" }}</span>
  </div>

</div>
</body>
</html>
